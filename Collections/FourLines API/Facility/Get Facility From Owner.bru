meta {
  name: Get Facility From Owner
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v{{apiVersion}}/facilities/:facilityId
  body: none
  auth: inherit
}

params:path {
  facilityId: 3b3b2306-27c2-45e1-8de4-18a0ea4621a9
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

script:post-response {
  test("Status 2xx",()=>expect(res.getStatus()).to.be.within(200,299));
}

settings {
  encodeUrl: true
  timeout: 0
}
