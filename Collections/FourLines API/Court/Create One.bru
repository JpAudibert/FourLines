meta {
  name: Create One
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v{{apiVersion}}/facilities/:facilityId/courts
  body: json
  auth: inherit
}

params:path {
  facilityId: 3b3b2306-27c2-45e1-8de4-18a0ea4621a9
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Qaudra do jogo da bola",
    "sportId": "64a10e6d-3648-4fcc-b2e7-6df83a57826c",
    "isActive": true,
    "defaultPrice": {
      "amount": 50.00,
      "currency": "BRL"
    },
    "rentingPeriodInMinutes": 60,
    "maintenancePeriodInMinutes": 0
  }
}

script:post-response {
  test("Status 2xx",()=>expect(res.getStatus()).to.be.within(200,299));
}

settings {
  encodeUrl: true
  timeout: 0
}
