meta {
  name: Get Match Details
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v{{apiVersion}}/presentation/matches/:matchId
  body: none
  auth: inherit
}

params:path {
  matchId: 83a79c32-f9c6-4b6e-b949-97913cf53423
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("Status 2xx", () => expect(res.getStatus()).to.be.within(200, 299));
}

settings {
  encodeUrl: true
  timeout: 0
}
