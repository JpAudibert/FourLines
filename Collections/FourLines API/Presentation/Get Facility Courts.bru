meta {
  name: Get Facility Courts
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v{{apiVersion}}/presentation/facilities/:facilityId/courts
  body: none
  auth: inherit
}

params:path {
  facilityId: {{facilityId}}
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("Status 2xx", () => expect(res.getStatus()).to.be.within(200, 299));
}

settings {
  encodeUrl: true
  timeout: 0
}
