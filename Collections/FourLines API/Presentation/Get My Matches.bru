meta {
  name: Get My Matches
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v{{apiVersion}}/presentation/matches/me?limit=5
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("Status 2xx", () => expect(res.getStatus()).to.be.within(200, 299));
}

settings {
  encodeUrl: true
  timeout: 0
}
