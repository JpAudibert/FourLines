meta {
  name: Get Home
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v{{apiVersion}}/presentation/home?cityName=Test%20City
  body: none
  auth: inherit
}

params:query {
  cityName: Test%20City
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("Status 2xx", () => expect(res.getStatus()).to.be.within(200, 299));
}

settings {
  encodeUrl: true
  timeout: 0
}
