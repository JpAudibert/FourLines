meta {
  name: Get Facility Schedules
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v{{apiVersion}}/facilities/:facilityId/schedules
  body: none
  auth: inherit
}

params:path {
  facilityId: 84bdc5b7-8f77-406d-8c9f-d962e3dd61df84bdc5b7-8f77-406d-8c9f-d962e3dd61df
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

script:post-response {
  test("Status 2xx",()=>expect(res.getStatus()).to.be.within(200,299));
}

settings {
  encodeUrl: true
  timeout: 0
}
